{
  "name": "bloknotik-recipes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "typecheck": "astro check && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run contracts:check && npm run typecheck && npm test && npm run build && npm run check:output",
    "check:output": "tsx scripts/check-output.ts",
    "content:import": "tsx scripts/import-content.ts",
    "content:publish": "tsx scripts/release-content.ts",
    "test:browser": "playwright test",
    "content:import:github": "tsx scripts/github-import.ts",
    "contracts:check": "node contracts/check-artifact.mjs"
  },
  "dependencies": {
    "astro": "7.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "cheerio": "1.2.0",
    "fast-xml-parser": "5.11.2",
    "fast-xml-validator": "1.4.2",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
