---
interface Props { title?: string; text?: string }
const { title = 'Первые рецепты ещё готовятся', text = 'Здесь появятся материалы после приготовления, проверки и редакционного утверждения. Хорошим рецептам нужно немного времени.' } = Astro.props;
---
<div class="empty-state"><span class="empty-symbol" aria-hidden="true">✳︎</span><div><h3>{title}</h3><p>{text}</p></div></div>
