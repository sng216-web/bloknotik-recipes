---
import Base from '../../layouts/Base.astro';
import RecipeView from '../../components/RecipeView.astro';
import { publishedRecipes } from '../../lib/catalog';
import { recipeJsonLd } from '../../lib/seo';
import type { Recipe } from '../../lib/recipe-schema';
export function getStaticPaths() { return publishedRecipes().map((recipe) => ({ params: { slug: recipe.slug }, props: { recipe } })); }
interface Props { recipe: Recipe }
const { recipe } = Astro.props;
---
<Base title={recipe.editorial?.content.seoTitle ?? recipe.title} description={recipe.description} canonicalPath={`recipes/${recipe.slug}/`} image={recipe.images.find((image) => image.kind === 'cover')!.src} jsonLd={recipeJsonLd(recipe)}><RecipeView recipe={recipe} /></Base>
