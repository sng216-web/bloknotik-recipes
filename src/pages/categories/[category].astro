---
import Base from '../../layouts/Base.astro';
import EmptyState from '../../components/EmptyState.astro';
import RecipeCard from '../../components/RecipeCard.astro';
import { CATEGORIES, type Category } from '../../lib/recipe-schema';
import { publishedRecipes } from '../../lib/catalog';
import { pathFor } from '../../lib/site-config';
export function getStaticPaths() { return Object.keys(CATEGORIES).map((category) => ({ params: { category } })); }
const category = Astro.params.category as Category;
const info = CATEGORIES[category];
const recipes = publishedRecipes().filter((recipe) => recipe.category === category);
---
<Base title={info.title} canonicalPath={`categories/${category}/`} description={info.description}>
  <section class="container page-intro"><a class="text-link" href={pathFor('categories/')}>← Все категории</a><span class="eyebrow">{recipes.length} опубликованных рецептов</span><h1>{info.title}</h1><p class="lead">{info.description}</p></section>
  <section class="container section category-results" aria-label={`Рецепты: ${info.title}`}>{recipes.length ? <div class="recipe-grid">{recipes.map((recipe) => <RecipeCard recipe={recipe} />)}</div> : <EmptyState title="В этой рубрике пока тихо" text="Первый рецепт появится после редакционной проверки. Демонстрационные примеры не считаются публикациями." />}</section>
</Base>
